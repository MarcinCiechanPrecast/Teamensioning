{
  "name": "@teamensioning/code-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone code-review agent (Vercel AI SDK + OpenRouter): a git diff in, a structured verdict out.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "review": "tsx --env-file-if-exists=.env src/cli.ts",
    "review:dry": "tsx src/cli.ts --dry-run",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
