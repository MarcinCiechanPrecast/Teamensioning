diff --git a/src/lib/services/standings.ts b/src/lib/services/standings.ts
index 5b1c0aa..e8d9f31 100644
--- a/src/lib/services/standings.ts
+++ b/src/lib/services/standings.ts
@@ -1,3 +1,8 @@
+/** Points awarded for a result under a league's scoring rule (3/1/0 by default). */
+export function pointsFor(result: "win" | "draw" | "loss", rule: { win: number; draw: number; loss: number }): number {
+  return rule[result];
+}
+
 export function resultFor(scoreA: number, scoreB: number): "win" | "draw" | "loss" {
   if (scoreA === scoreB) return "draw";
   return scoreA > scoreB ? "win" : "loss";
