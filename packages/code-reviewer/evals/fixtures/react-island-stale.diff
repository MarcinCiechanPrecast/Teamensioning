+export default function LiveStandings({ leagueId, note }: Props) {
+  const [rows, setRows] = useState<Row[]>([]);
+
+  useEffect(() => {
+    async function load() {
+      const res = await fetch(`/api/leagues/${leagueId}/standings`);
+      const data = await res.json();
+      setRows(data.rows);
+    }
+    load();
+    setInterval(load, 5000);
+  }, []);
+
+  return (
+    <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
+      <ul>
+        {rows.map((row) => (
+          <li key={row.playerId}>
+            {row.name}: {row.points}
+          </li>
+        ))}
+      </ul>
+      <p dangerouslySetInnerHTML={{ __html: note }} />
+    </div>
+  );
+}
