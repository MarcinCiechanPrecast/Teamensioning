diff --git a/supabase/migrations/20261120090000_add_tournament_notes.sql b/supabase/migrations/20261120090000_add_tournament_notes.sql
new file mode 100644
index 0000000..a91f0c3
--- /dev/null
+++ b/supabase/migrations/20261120090000_add_tournament_notes.sql
@@ -0,0 +1,14 @@
+-- Organizer notes shown on the tournament page.
+
+create table public.tournament_notes (
+  id uuid primary key default gen_random_uuid(),
+  tournament_id uuid not null references public.tournaments on delete cascade,
+  body text not null,
+  created_at timestamptz not null default now()
+);
+
+create index tournament_notes_tournament_id_idx on public.tournament_notes (tournament_id);
+
+-- The old per-match timestamp is replaced by the notes feature.
+alter table public.matches drop column played_at;
+
