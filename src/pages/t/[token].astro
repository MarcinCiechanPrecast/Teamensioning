---
import Layout from "@/layouts/Layout.astro";
import Bracket from "@/components/cup/Bracket.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { createClient } from "@/lib/supabase";
import {
  filterFixturesByPlayer,
  isValidShareToken,
  playedMatchIds,
  resolvePlayerFilter,
  toSharedLeague,
} from "@/lib/services/shared-league";
import { buildBracketView } from "@/lib/services/bracket-view";
import { SCORE_ERROR_MESSAGES, isScoreErrorCode } from "@/lib/services/score-submission";
import { computeStandings } from "@/lib/services/standings";
import { cn } from "@/lib/utils";
import type { SharedLeagueDTO } from "@/types";

async function loadSharedLeague(token: string | undefined): Promise<SharedLeagueDTO | null> {
  // A malformed token never reaches the database; it looks exactly like an unknown one.
  if (!isValidShareToken(token)) return null;

  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) return null;

  // Runs as anon: get_shared_league is the only anonymous read path.
  const { data, error } = await supabase.rpc("get_shared_league", { p_token: token });
  if (error) throw new Error(error.message);

  return toSharedLeague(data);
}

// The token is the only secret: keep the page out of search indexes and never leak the URL via Referer.
// "same-origin", not "no-referrer": no-referrer makes browsers send `Origin: null` on the score form POST,
// which Astro's CSRF origin check rejects. Cross-origin requests still get no Referer.
Astro.response.headers.set("X-Robots-Tag", "noindex");
Astro.response.headers.set("Referrer-Policy", "same-origin");

const shared = await loadSharedLeague(Astro.params.token);
if (!shared) {
  Astro.response.status = 404;
}

const selectedPlayerId = shared ? resolvePlayerFilter(shared.players, Astro.url.searchParams.get("player")) : null;
const visibleFixtures = shared
  ? filterFixturesByPlayer(shared.fixtures, selectedPlayerId, playedMatchIds(shared.fixtures))
  : [];
const playedFixtures = shared ? shared.fixtures.filter((fixture) => fixture.score !== null) : [];
const standings = shared ? computeStandings(shared) : [];
const isCup = shared?.format === "cup";
const bracketView = shared?.cupMatches ? buildBracketView(shared.cupMatches) : null;
const token = Astro.params.token ?? "";
// The query string only selects a fixed message: free text from a crafted link is never shown.
const errorCode = Astro.url.searchParams.get("error");
const errorMessage = isScoreErrorCode(errorCode) ? SCORE_ERROR_MESSAGES[errorCode] : null;
const alreadyEntered = Astro.url.searchParams.get("notice") === "already-entered";

const fieldClass = cn(
  "border-input bg-background text-foreground rounded-lg border",
  "focus-visible:ring-ring outline-hidden focus-visible:ring-2",
);
const scoreInputClass = cn(fieldClass, "w-16 px-2 py-1");
const rowClass = "border-border bg-card text-card-foreground rounded-lg border px-4 py-2";
---

<Layout title={shared ? shared.league.name : "League not found"}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-lg gap-0 p-8">
      {shared && isCup && bracketView ? (
        <>
          <h1 class="text-foreground mb-2 text-3xl font-bold break-words">{shared.league.name}</h1>
          <p class="text-muted-foreground">Cup</p>
          {errorMessage && (
            <Alert variant="destructive" className="mt-4">
              <AlertDescription>{errorMessage}</AlertDescription>
            </Alert>
          )}
          {alreadyEntered && (
            <Alert variant="success" role="status" className="mt-4">
              <AlertDescription>A score was already entered for that match. It is shown below.</AlertDescription>
            </Alert>
          )}
          <div class="mt-6">
            <Bracket view={bracketView} mode="enter" action="/api/scores" token={token} />
          </div>
        </>
      ) : shared ? (
        <>
          <h1 class="text-foreground mb-2 text-3xl font-bold break-words">{shared.league.name}</h1>
          <p class="text-muted-foreground">
            W {shared.league.points_win} / D {shared.league.points_draw} / L {shared.league.points_loss}
          </p>
          {playedFixtures.length === 0 ? (
            <p class="mt-6 text-sm text-muted-foreground">No scores yet</p>
          ) : (
            <div class="mt-6 overflow-x-auto">
              <table class="w-full text-sm">
                <caption class="pb-2 text-left text-muted-foreground">Standings</caption>
                <thead>
                  <tr class="border-b border-border text-muted-foreground">
                    <th scope="col" class="py-1 pr-2 text-left font-normal">
                      Rank
                    </th>
                    <th scope="col" class="py-1 pr-2 text-left font-normal">
                      Player
                    </th>
                    {["P", "W", "D", "L", "GF", "GA", "GD", "Pts"].map((heading) => (
                      <th scope="col" class="px-1 py-1 text-right font-normal">
                        {heading}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {standings.map((row) => (
                    <tr class="border-b border-border">
                      <td class="py-1 pr-2">{row.rank}</td>
                      <th scope="row" class="py-1 pr-2 text-left font-normal">
                        {row.player.name}
                      </th>
                      <td class="px-1 py-1 text-right">{row.played}</td>
                      <td class="px-1 py-1 text-right">{row.won}</td>
                      <td class="px-1 py-1 text-right">{row.drawn}</td>
                      <td class="px-1 py-1 text-right">{row.lost}</td>
                      <td class="px-1 py-1 text-right">{row.goalsFor}</td>
                      <td class="px-1 py-1 text-right">{row.goalsAgainst}</td>
                      <td class="px-1 py-1 text-right">
                        {row.goalDifference > 0 ? `+${row.goalDifference}` : row.goalDifference}
                      </td>
                      <td class="px-1 py-1 text-right font-semibold">{row.points}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          <form method="get" class="mt-6 flex items-center gap-2">
            <label for="player" class="text-muted-foreground text-sm">
              Player
            </label>
            <select id="player" name="player" class:list={cn(fieldClass, "min-w-0 flex-1 px-3 py-2")}>
              <option value="" class="bg-background text-foreground" selected={selectedPlayerId === null}>
                All players
              </option>
              {shared.players.map((player) => (
                <option
                  value={player.id}
                  class="bg-background text-foreground"
                  selected={player.id === selectedPlayerId}
                >
                  {player.name}
                </option>
              ))}
            </select>
            <button type="submit" class:list={buttonVariants({ variant: "outline" })}>
              Filter
            </button>
          </form>
          {errorMessage && (
            <Alert variant="destructive" className="mt-4">
              <AlertDescription>{errorMessage}</AlertDescription>
            </Alert>
          )}
          {alreadyEntered && (
            <Alert variant="success" role="status" className="mt-4">
              <AlertDescription>A score was already entered for that match. It is shown below.</AlertDescription>
            </Alert>
          )}
          <p class="text-muted-foreground mt-4 text-sm">{visibleFixtures.length} to play</p>
          <ol class="mt-2 space-y-2">
            {visibleFixtures.map((fixture) => (
              <li class:list={rowClass}>
                <form method="POST" action="/api/scores" class="flex flex-wrap items-center gap-2">
                  <input type="hidden" name="token" value={token} />
                  <input type="hidden" name="matchId" value={fixture.id} />
                  <span class="min-w-0 basis-full break-words sm:flex-1">
                    {fixture.position}. {fixture.playerA.name} vs {fixture.playerB.name}
                  </span>
                  <input
                    type="number"
                    name="scoreA"
                    required
                    min="0"
                    max="99"
                    step="1"
                    inputmode="numeric"
                    aria-label={`Score of ${fixture.playerA.name}`}
                    class:list={scoreInputClass}
                  />
                  <span aria-hidden="true">–</span>
                  <input
                    type="number"
                    name="scoreB"
                    required
                    min="0"
                    max="99"
                    step="1"
                    inputmode="numeric"
                    aria-label={`Score of ${fixture.playerB.name}`}
                    class:list={scoreInputClass}
                  />
                  <button type="submit" class:list={buttonVariants({ variant: "outline", size: "sm" })}>
                    Save
                  </button>
                </form>
              </li>
            ))}
          </ol>
          {playedFixtures.length > 0 && (
            <>
              <h2 class="text-muted-foreground mt-6 text-sm">Played ({playedFixtures.length})</h2>
              <ol class="mt-2 space-y-2">
                {playedFixtures.map((fixture) => (
                  <li class:list={rowClass}>
                    {fixture.playerA.name} {fixture.score?.a}–{fixture.score?.b} {fixture.playerB.name}
                  </li>
                ))}
              </ol>
            </>
          )}
        </>
      ) : (
        <>
          <h1 class="text-foreground mb-2 text-2xl font-bold">League not found</h1>
          <p class="text-muted-foreground">This link is not valid.</p>
        </>
      )}
    </Card>
  </div>
</Layout>
