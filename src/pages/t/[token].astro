---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import {
  filterFixturesByPlayer,
  isValidShareToken,
  playedMatchIds,
  resolvePlayerFilter,
  toSharedLeague,
} from "@/lib/services/shared-league";
import { SCORE_ERROR_MESSAGES, isScoreErrorCode } from "@/lib/services/score-submission";
import type { SharedLeagueDTO } from "@/types";

async function loadSharedLeague(token: string | undefined): Promise<SharedLeagueDTO | null> {
  // A malformed token never reaches the database; it looks exactly like an unknown one.
  if (!isValidShareToken(token)) return null;

  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) return null;

  // Runs as anon: get_shared_league is the only anonymous read path.
  const { data, error } = await supabase.rpc("get_shared_league", { p_token: token });
  if (error) throw new Error(error.message);

  return toSharedLeague(data);
}

// The token is the only secret: keep the page out of search indexes and never leak the URL via Referer.
// "same-origin", not "no-referrer": no-referrer makes browsers send `Origin: null` on the score form POST,
// which Astro's CSRF origin check rejects. Cross-origin requests still get no Referer.
Astro.response.headers.set("X-Robots-Tag", "noindex");
Astro.response.headers.set("Referrer-Policy", "same-origin");

const shared = await loadSharedLeague(Astro.params.token);
if (!shared) {
  Astro.response.status = 404;
}

const selectedPlayerId = shared ? resolvePlayerFilter(shared.players, Astro.url.searchParams.get("player")) : null;
const visibleFixtures = shared
  ? filterFixturesByPlayer(shared.fixtures, selectedPlayerId, playedMatchIds(shared.fixtures))
  : [];
const playedFixtures = shared ? shared.fixtures.filter((fixture) => fixture.score !== null) : [];
const token = Astro.params.token ?? "";
// The query string only selects a fixed message: free text from a crafted link is never shown.
const errorCode = Astro.url.searchParams.get("error");
const errorMessage = isScoreErrorCode(errorCode) ? SCORE_ERROR_MESSAGES[errorCode] : null;
const alreadyEntered = Astro.url.searchParams.get("notice") === "already-entered";
---

<Layout title={shared ? shared.league.name : "League not found"}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      {shared ? (
        <>
          <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            {shared.league.name}
          </h1>
          <p class="text-blue-100/80">
            W {shared.league.points_win} / D {shared.league.points_draw} / L {shared.league.points_loss}
          </p>
          <form method="get" class="mt-6 flex items-center gap-2">
            <label for="player" class="text-sm text-blue-100/80">
              Player
            </label>
            <select
              id="player"
              name="player"
              class="min-w-0 flex-1 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-white"
            >
              <option value="" class="text-black" selected={selectedPlayerId === null}>
                All players
              </option>
              {shared.players.map((player) => (
                <option value={player.id} class="text-black" selected={player.id === selectedPlayerId}>
                  {player.name}
                </option>
              ))}
            </select>
            <button type="submit" class="rounded-lg border border-white/10 bg-white/10 px-4 py-2 hover:bg-white/20">
              Filter
            </button>
          </form>
          {errorMessage && (
            <p role="alert" class="mt-4 rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-2 text-red-200">
              {errorMessage}
            </p>
          )}
          {alreadyEntered && (
            <p role="status" class="mt-4 rounded-lg border border-blue-300/30 bg-blue-500/10 px-4 py-2 text-blue-100">
              A score was already entered for that match. It is shown below.
            </p>
          )}
          <p class="mt-4 text-sm text-blue-100/50">{visibleFixtures.length} to play</p>
          <ol class="mt-2 space-y-2">
            {visibleFixtures.map((fixture) => (
              <li class="rounded-lg border border-white/10 bg-white/5 px-4 py-2">
                <form method="POST" action="/api/scores" class="flex flex-wrap items-center gap-2">
                  <input type="hidden" name="token" value={token} />
                  <input type="hidden" name="matchId" value={fixture.id} />
                  <span class="min-w-0 flex-1">
                    {fixture.position}. {fixture.playerA.name} vs {fixture.playerB.name}
                  </span>
                  <input
                    type="number"
                    name="scoreA"
                    required
                    min="0"
                    max="99"
                    step="1"
                    inputmode="numeric"
                    aria-label={`Score of ${fixture.playerA.name}`}
                    class="w-16 rounded-lg border border-white/10 bg-white/5 px-2 py-1 text-white"
                  />
                  <span aria-hidden="true">–</span>
                  <input
                    type="number"
                    name="scoreB"
                    required
                    min="0"
                    max="99"
                    step="1"
                    inputmode="numeric"
                    aria-label={`Score of ${fixture.playerB.name}`}
                    class="w-16 rounded-lg border border-white/10 bg-white/5 px-2 py-1 text-white"
                  />
                  <button
                    type="submit"
                    class="rounded-lg border border-white/10 bg-white/10 px-3 py-1 hover:bg-white/20"
                  >
                    Save
                  </button>
                </form>
              </li>
            ))}
          </ol>
          {playedFixtures.length > 0 && (
            <>
              <h2 class="mt-6 text-sm text-blue-100/50">Played ({playedFixtures.length})</h2>
              <ol class="mt-2 space-y-2">
                {playedFixtures.map((fixture) => (
                  <li class="rounded-lg border border-white/10 bg-white/5 px-4 py-2">
                    {fixture.playerA.name} {fixture.score?.a}–{fixture.score?.b} {fixture.playerB.name}
                  </li>
                ))}
              </ol>
            </>
          )}
        </>
      ) : (
        <>
          <h1 class="mb-2 text-2xl font-bold">League not found</h1>
          <p class="text-blue-100/80">This link is not valid.</p>
        </>
      )}
    </div>
  </div>
</Layout>
