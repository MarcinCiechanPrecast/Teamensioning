---
import Layout from "@/layouts/Layout.astro";
import CreateLeagueForm from "@/components/leagues/CreateLeagueForm";
import { Card, CardContent, CardHeader } from "@/components/ui/card";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Create league">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-lg">
      <CardHeader>
        <h1 class="text-foreground text-center text-2xl leading-none font-semibold">Create league</h1>
      </CardHeader>
      <CardContent className="flex flex-col gap-4">
        <CreateLeagueForm serverError={error} client:load />
        <p class="text-muted-foreground text-center text-sm">
          <a
            href="/dashboard"
            class="text-primary focus-visible:ring-ring rounded-sm outline-hidden hover:underline focus-visible:ring-2"
          >
            Back to dashboard
          </a>
        </p>
      </CardContent>
    </Card>
  </div>
</Layout>
