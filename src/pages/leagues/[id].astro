---
import Layout from "@/layouts/Layout.astro";
import Bracket from "@/components/cup/Bracket.astro";
import CopyLinkField from "@/components/leagues/CopyLinkField";
import OrganizerFixtureList from "@/components/leagues/OrganizerFixtureList.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card } from "@/components/ui/card";
import { buildBracketView } from "@/lib/services/bracket-view";
import { createClient } from "@/lib/supabase";
import { cn } from "@/lib/utils";
import { CORRECTION_ERROR_MESSAGES, isCorrectionErrorCode } from "@/lib/services/score-correction";
import type { CupMatchDTO, FixtureDTO, PlayerDTO, TournamentDTO, TournamentFormat } from "@/types";

// PostgREST answers a malformed uuid with 22P02; to the organizer that is simply "not found".
const INVALID_TEXT_REPRESENTATION = "22P02";

interface LoadedLeague {
  league: TournamentDTO;
  shareToken: string;
  format: TournamentFormat;
  fixtures: FixtureDTO[];
  /** Cup only: every match, open slots included. */
  cupMatches: CupMatchDTO[];
}

async function loadLeague(id: string | undefined): Promise<LoadedLeague | null> {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!id || !supabase) return null;

  // RLS only returns the organizer's own tournaments, so "not the owner" also lands here as null.
  const { data: league, error: leagueError } = await supabase
    .from("tournaments")
    .select("id, name, format, points_win, points_draw, points_loss, created_at")
    .eq("id", id)
    .maybeSingle();

  if (leagueError) {
    if (leagueError.code === INVALID_TEXT_REPRESENTATION) return null;
    throw new Error(leagueError.message);
  }
  if (!league) return null;

  // Selected separately so TournamentDTO never carries the token.
  const { data: tokenRow, error: tokenError } = await supabase
    .from("tournaments")
    .select("share_token")
    .eq("id", league.id)
    .single();
  if (tokenError) throw new Error(tokenError.message);

  const [playersResult, matchesResult] = await Promise.all([
    supabase.from("players").select("id, name").eq("tournament_id", league.id),
    supabase
      .from("matches")
      .select("id, position, round, next_match_id, player_a_id, player_b_id, results(score_a, score_b)")
      .eq("tournament_id", league.id)
      .order("position", { ascending: true }),
  ]);

  if (playersResult.error) throw new Error(playersResult.error.message);
  if (matchesResult.error) throw new Error(matchesResult.error.message);

  const playersById = new Map<string, PlayerDTO>(playersResult.data.map((player) => [player.id, player]));

  const format: TournamentFormat = league.format === "cup" ? "cup" : "league";

  const cupMatches: CupMatchDTO[] =
    format === "cup"
      ? matchesResult.data.map((match) => ({
          id: match.id,
          position: match.position,
          round: match.round ?? 1,
          playerA: match.player_a_id ? (playersById.get(match.player_a_id) ?? null) : null,
          playerB: match.player_b_id ? (playersById.get(match.player_b_id) ?? null) : null,
          // results is one-to-one with matches: an object once played, null before.
          score: match.results ? { a: match.results.score_a, b: match.results.score_b } : null,
          nextMatchId: match.next_match_id,
        }))
      : [];

  const fixtures = matchesResult.data.flatMap((match): FixtureDTO[] => {
    // League matches always have both players; a cup is rendered from cupMatches (open slots are null).
    const playerA = match.player_a_id ? playersById.get(match.player_a_id) : undefined;
    const playerB = match.player_b_id ? playersById.get(match.player_b_id) : undefined;
    if (!playerA || !playerB) return [];
    // results is one-to-one with matches: an object once played, null before.
    const score = match.results ? { a: match.results.score_a, b: match.results.score_b } : null;
    return [{ id: match.id, position: match.position, playerA, playerB, score }];
  });

  return { league, shareToken: tokenRow.share_token, format, fixtures, cupMatches };
}

const result = await loadLeague(Astro.params.id);
const isCup = result?.format === "cup";
const bracketView = result && isCup ? buildBracketView(result.cupMatches) : null;
if (!result) {
  Astro.response.status = 404;
}

// The query string only selects a fixed message: free text from a crafted link is never shown.
const errorCode = Astro.url.searchParams.get("error");
const errorMessage = isCorrectionErrorCode(errorCode) ? CORRECTION_ERROR_MESSAGES[errorCode] : null;
const notice = Astro.url.searchParams.get("notice") === "score-updated" ? "Score updated." : null;

const focusClass = "focus-visible:ring-ring rounded-sm outline-hidden focus-visible:ring-2";
const linkClass = cn("text-primary hover:underline", focusClass);
---

<Layout title={result ? result.league.name : "League not found"}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-lg gap-0 p-8">
      {result ? (
        <>
          <h1 class="text-foreground mb-2 text-3xl font-bold break-words">{result.league.name}</h1>
          {isCup ? (
            <>
              <p class="text-muted-foreground">Cup</p>
              <p class="text-muted-foreground mt-1 text-sm">{result.cupMatches.length} matches</p>
            </>
          ) : (
            <>
              <p class="text-muted-foreground">
                W {result.league.points_win} / D {result.league.points_draw} / L {result.league.points_loss}
              </p>
              <p class="text-muted-foreground mt-1 text-sm">{result.fixtures.length} matches</p>
            </>
          )}
          <div class="mt-6">
            <p class="text-muted-foreground mb-2 text-sm">Share link</p>
            <CopyLinkField url={`${Astro.url.origin}/t/${result.shareToken}`} client:load />
          </div>
          {bracketView ? (
            <>
              {errorMessage && (
                <Alert variant="destructive" className="mt-4">
                  <AlertDescription>{errorMessage}</AlertDescription>
                </Alert>
              )}
              {notice && (
                <Alert variant="success" role="status" className="mt-4">
                  <AlertDescription>{notice}</AlertDescription>
                </Alert>
              )}
              <div class="mt-6">
                <Bracket view={bracketView} mode="correct" action={`/api/leagues/${result.league.id}/scores`} />
              </div>
            </>
          ) : (
            <OrganizerFixtureList
              leagueId={result.league.id}
              fixtures={result.fixtures}
              errorMessage={errorMessage}
              notice={notice}
            />
          )}
          <p class="mt-6 flex items-center justify-between text-sm">
            <a href="/dashboard" class:list={linkClass}>
              Back to dashboard
            </a>
            <a href={`/leagues/${result.league.id}/edit`} class:list={linkClass}>
              Edit settings
            </a>
            <a
              href={`/leagues/${result.league.id}/delete`}
              class:list={cn("text-destructive hover:underline", focusClass)}
            >
              Delete league
            </a>
          </p>
        </>
      ) : (
        <>
          <h1 class="text-foreground mb-2 text-2xl font-bold">League not found</h1>
          <p class="text-muted-foreground">This league does not exist or you do not have access to it.</p>
        </>
      )}
    </Card>
  </div>
</Layout>
