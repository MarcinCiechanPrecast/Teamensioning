---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { Card } from "@/components/ui/card";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-sm p-8">
      <h1 class="text-foreground text-center text-2xl font-bold">Sign up</h1>
      <SignUpForm serverError={error} client:load />
      <p class="text-muted-foreground text-center text-sm">
        Already have an account?{" "}
        <a
          href="/auth/signin"
          class="text-primary focus-visible:ring-ring rounded-sm outline-hidden hover:underline focus-visible:ring-2"
        >
          Sign in
        </a>
      </p>
    </Card>
  </div>
</Layout>
