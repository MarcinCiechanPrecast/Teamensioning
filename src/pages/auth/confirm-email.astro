---
import Layout from "@/layouts/Layout.astro";
import { Card } from "@/components/ui/card";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      emoji: "📧",
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-sm gap-4 p-8 text-center">
      <div class="text-5xl">{content.emoji}</div>
      <h1 class="text-foreground text-2xl font-bold">{content.heading}</h1>
      <p class="text-muted-foreground">{content.description}</p>
      <div>
        <a
          href="/auth/signin"
          class="text-primary focus-visible:ring-ring rounded-sm text-sm outline-hidden hover:underline focus-visible:ring-2"
        >
          {content.linkText}
        </a>
      </div>
    </Card>
  </div>
</Layout>
