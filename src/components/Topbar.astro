---
const { user } = Astro.locals;

const linkClass =
  "text-primary focus-visible:ring-ring cursor-pointer rounded-sm outline-hidden hover:underline focus-visible:ring-2";
---

<div class="border-border bg-card text-card-foreground mb-4 flex items-center justify-between gap-3 rounded-xl border px-4 py-2 text-sm shadow-sm">
  {user ? (
    <>
      <span class="text-muted-foreground min-w-0 truncate">{user.email}</span>
      <div class="flex shrink-0 items-center gap-3">
        <a href="/dashboard" class:list={linkClass}>
          Dashboard
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class:list={linkClass}>
            Sign out
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-muted-foreground min-w-0 truncate">Not signed in</span>
      <div class="flex shrink-0 gap-3">
        <a href="/auth/signin" class:list={linkClass}>
          Sign in
        </a>
        <a href="/auth/signup" class:list={linkClass}>
          Sign up
        </a>
      </div>
    </>
  )}
</div>
