---
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import type { FixtureDTO } from "@/types";

interface Props {
  leagueId: string;
  fixtures: FixtureDTO[];
  errorMessage: string | null;
  notice: string | null;
}

const { leagueId, fixtures, errorMessage, notice } = Astro.props;

const inputClass = cn(
  "border-input bg-background text-foreground w-16 rounded-lg border px-2 py-1",
  "focus-visible:ring-ring outline-hidden focus-visible:ring-2",
);
---

{errorMessage && (
  <Alert variant="destructive" className="mt-4">
    <AlertDescription>{errorMessage}</AlertDescription>
  </Alert>
)}
{notice && (
  <Alert variant="success" role="status" className="mt-4">
    <AlertDescription>{notice}</AlertDescription>
  </Alert>
)}
<ol class="mt-6 space-y-2">
  {fixtures.map((fixture) => (
    <li class="border-border bg-card text-card-foreground rounded-lg border px-4 py-2">
      {fixture.score ? (
        <form method="POST" action={`/api/leagues/${leagueId}/scores`} class="flex flex-wrap items-center gap-2">
          <input type="hidden" name="matchId" value={fixture.id} />
          <span class="min-w-0 basis-full break-words sm:flex-1">
            {fixture.position}. {fixture.playerA.name} vs {fixture.playerB.name}
          </span>
          <input
            type="number"
            name="scoreA"
            required
            min="0"
            max="99"
            step="1"
            inputmode="numeric"
            value={fixture.score.a}
            aria-label={`Score of ${fixture.playerA.name}`}
            class:list={inputClass}
          />
          <span aria-hidden="true">–</span>
          <input
            type="number"
            name="scoreB"
            required
            min="0"
            max="99"
            step="1"
            inputmode="numeric"
            value={fixture.score.b}
            aria-label={`Score of ${fixture.playerB.name}`}
            class:list={inputClass}
          />
          <button type="submit" class:list={buttonVariants({ variant: "outline", size: "sm" })}>
            Save
          </button>
        </form>
      ) : (
        <span class="break-words">
          {fixture.position}. {fixture.playerA.name} vs {fixture.playerB.name}
        </span>
      )}
    </li>
  ))}
</ol>
