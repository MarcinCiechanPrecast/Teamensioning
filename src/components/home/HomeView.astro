---
/**
 * Landing page. The name is Team + Dimensioning: in an engineering drawing, dimensioning states
 * every size and tolerance so anyone can build the part without asking.
 *
 * Kept deliberately short (ui-polish-home research: Kicktipp, start.gg, Tournify): one hero with a
 * single primary CTA, a demo fixture card built like the real score rows, three steps, one closing CTA.
 * Motion is a staggered fade-up plus the dimension line drawing itself, all behind `motion-safe:`
 * so `prefers-reduced-motion` users get the static page.
 */
import Topbar from "@/components/Topbar.astro";
import DimensionLine from "@/components/home/DimensionLine.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import { cn } from "@/lib/utils";

interface Props {
  signedIn: boolean;
}

const { signedIn } = Astro.props;

const primary = signedIn
  ? { href: "/dashboard", label: "Go to dashboard" }
  : { href: "/auth/signup", label: "Create your league — free" };
const secondary = signedIn
  ? { href: "/leagues/new", label: "Create league" }
  : { href: "/auth/signin", label: "Sign in" };

const steps = [
  {
    number: "01",
    title: "Draft the league",
    body: "Name it, pick league or cup, add players. Fixtures are drawn for you.",
  },
  { number: "02", title: "Share one link", body: "Players open it and enter their own scores. No account needed." },
  { number: "03", title: "Read the standings", body: "The table recalculates the moment a score lands." },
];

const demoFixtures = [
  { a: "Ana", b: "Ben", score: "3 : 1" },
  { a: "Chris", b: "Dana", score: "2 : 2" },
  { a: "Eve", b: "Finn", score: null },
];

/** Staggered entrance; tw-animate-css utilities, only when the user allows motion. */
const reveal =
  "motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-4 motion-safe:duration-700 motion-safe:fill-mode-both";
const stagger = [
  "motion-safe:delay-75",
  "motion-safe:delay-150",
  "motion-safe:delay-300",
  "motion-safe:delay-500",
  "motion-safe:delay-700",
];
---

<div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
  <div class="bg-primary/20 pointer-events-none absolute top-24 -left-24 size-80 rounded-full blur-3xl motion-safe:animate-pulse"></div>

  <div class="relative z-10 mx-auto flex max-w-5xl flex-col gap-20 p-4 pb-24 sm:p-8 sm:pb-32">
    <Topbar />

    <section aria-labelledby="hero-heading" class="flex flex-col items-center gap-8 pt-8 text-center sm:pt-16">
      <p class:list={cn("text-muted-foreground font-mono text-xs tracking-widest uppercase", reveal)}>
        Team <span class="text-primary">+</span> Dimensioning
      </p>
      <div class:list={cn("flex w-full max-w-3xl flex-col items-center gap-4", reveal, stagger[0])}>
        <h1 id="hero-heading" class="text-foreground text-5xl leading-tight font-bold sm:text-7xl">
          Teamensioning
        </h1>
        <DimensionLine
          label="your office league, to spec"
          class="text-primary motion-safe:animate-draw motion-safe:delay-300"
        />
      </div>
      <p class:list={cn("text-muted-foreground max-w-xl text-lg sm:text-xl", reveal, stagger[1])}>
        Fixtures drawn for you, scores entered through one shared link, standings always right.
      </p>
      <div class:list={cn("flex flex-col gap-4 sm:flex-row", reveal, stagger[2])}>
        <a href={primary.href} class:list={buttonVariants({ size: "lg" })}>
          {primary.label}
        </a>
        <a href={secondary.href} class:list={buttonVariants({ variant: "ghost", size: "lg" })}>
          {secondary.label}
        </a>
      </div>

      <div aria-hidden="true" class:list={cn("w-full max-w-sm", reveal, stagger[3])}>
        <Card className="gap-2 p-4 text-left">
          <p class="text-muted-foreground font-mono text-xs tracking-widest uppercase">Round 1</p>
          <ol class="flex flex-col gap-2">
            {demoFixtures.map((fixture) => (
              <li class="border-border grid grid-cols-3 items-center rounded-lg border px-3 py-2 text-sm">
                <span class="text-card-foreground truncate text-right">{fixture.a}</span>
                <span
                  class:list={cn(
                    "text-center font-semibold tabular-nums",
                    fixture.score ? "text-primary" : "text-muted-foreground",
                  )}
                >
                  {fixture.score ?? "– : –"}
                </span>
                <span class="text-card-foreground truncate">{fixture.b}</span>
              </li>
            ))}
          </ol>
        </Card>
      </div>
    </section>

    <section aria-labelledby="steps-heading" class="flex flex-col gap-8">
      <div class="flex flex-col items-center gap-3 text-center">
        <h2 id="steps-heading" class="text-foreground text-3xl font-bold">
          From sketch to standings
        </h2>
        <DimensionLine label="3 steps" class="text-muted-foreground motion-safe:animate-draw max-w-md" />
      </div>
      <ol class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {steps.map((step, index) => (
          <li class:list={cn(reveal, stagger[index + 2])}>
            <Card className="hover:border-primary/60 h-full gap-3 p-6 transition-all hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
              <span class="text-primary font-mono text-sm font-semibold">{step.number}</span>
              <h3 class="text-card-foreground text-lg font-semibold">{step.title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{step.body}</p>
            </Card>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="start-heading" class="flex flex-col items-center gap-6 text-center">
      <h2 id="start-heading" class="text-foreground text-3xl font-bold">
        Put your league on paper — properly
      </h2>
      <a href={signedIn ? "/leagues/new" : "/auth/signup"} class:list={buttonVariants({ size: "lg" })}>
        {signedIn ? "Create league" : "Get started"}
      </a>
    </section>
  </div>
</div>
