---
/**
 * One score field: a centred number input between −/+ stepper buttons, drawn as a single
 * segmented control on the input tokens. Replaces the browser's native spinner arrows, which are
 * tiny, unthemed and look different in every browser (`no-spinner` hides them).
 *
 * The input keeps its accessible name (`label`, e.g. "Score of Ana"), so E2E and screen readers
 * find exactly one field. The steppers are a pointer convenience: hidden from assistive tech and
 * out of the tab order, because keyboard users already step with ArrowUp/ArrowDown on the input.
 */
import { cn } from "@/lib/utils";

interface Props {
  name: string;
  label: string;
  value?: number;
  min?: number;
  max?: number;
}

const { name, label, value, min = 0, max = 99 } = Astro.props;

const stepClass = cn(
  "text-muted-foreground hover:bg-accent hover:text-accent-foreground flex w-8 items-center justify-center sm:w-10",
  "transition-colors select-none active:scale-90 motion-reduce:transition-none motion-reduce:active:scale-100",
);
---

<span class="border-input bg-background focus-within:ring-ring inline-flex h-10 items-stretch overflow-hidden rounded-lg border focus-within:ring-2">
  <button type="button" tabindex="-1" aria-hidden="true" data-score-step="-1" class:list={stepClass}>
    −
  </button>
  <input
    type="number"
    name={name}
    required
    min={min}
    max={max}
    step="1"
    inputmode="numeric"
    value={value}
    aria-label={label}
    class="no-spinner text-foreground w-10 bg-transparent text-center font-semibold tabular-nums outline-hidden"
  />
  <button type="button" tabindex="-1" aria-hidden="true" data-score-step="1" class:list={stepClass}>
    +
  </button>
</span>

<script>
  // One delegated listener for every stepper on the page (Astro bundles this script once).
  document.addEventListener("click", (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-score-step]");
    const input = button?.parentElement?.querySelector<HTMLInputElement>("input[type=number]");
    if (!button || !input) return;
    const delta = Number(button.dataset.scoreStep);
    // An empty field starts from the minimum, so the first "+" gives 1 and the first "−" gives 0.
    // stepUp/stepDown clamp to min/max themselves.
    const wasEmpty = input.value === "";
    if (wasEmpty) input.value = input.min;
    if (delta > 0) input.stepUp();
    else if (!wasEmpty) input.stepDown();
    input.dispatchEvent(new Event("input", { bubbles: true }));
  });
</script>
