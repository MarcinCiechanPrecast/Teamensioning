---
import Topbar from "@/components/Topbar.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
---

<div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
  <!-- Cosmic orbs -->
  <div class="bg-primary/20 pointer-events-none absolute top-1/4 -left-24 size-80 rounded-full blur-3xl"></div>
  <div class="bg-accent/30 pointer-events-none absolute top-2/3 -right-16 size-64 rounded-full blur-3xl"></div>
  <div class="bg-primary/10 pointer-events-none absolute top-0 left-1/2 size-72 -translate-x-1/2 rounded-full blur-3xl"></div>

  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <!-- Hero section -->
    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1 class="text-foreground mb-6 text-5xl leading-tight font-bold sm:text-6xl lg:text-7xl">10x Astro Starter</h1>
      <p class="text-muted-foreground mb-10 max-w-2xl text-lg sm:text-xl">
        A production-ready starter with authentication, modern tooling, and a cosmic developer experience.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a href="/auth/signin" class:list={buttonVariants()}>
          Sign In
        </a>
        <a href="/auth/signup" class:list={buttonVariants({ variant: "outline" })}>
          Sign Up
        </a>
      </div>
    </div>

    <!-- Feature cards -->
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      <Card className="gap-0 p-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary mb-4"
        >
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <h3 class="text-card-foreground mb-2 text-lg font-semibold">Authentication Ready</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Built-in Supabase auth with sign in, sign up, and protected routes out of the box.
        </p>
      </Card>

      <Card className="gap-0 p-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary mb-4"
        >
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
        <h3 class="text-card-foreground mb-2 text-lg font-semibold">Modern Stack</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Astro 7, React 19, Tailwind 4, and TypeScript — the latest tools, ready to go.
        </p>
      </Card>

      <Card className="gap-0 p-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary mb-4"
        >
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <h3 class="text-card-foreground mb-2 text-lg font-semibold">Developer Experience</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          ESLint, Prettier, and pre-commit hooks keep your codebase clean from day one.
        </p>
      </Card>
    </div>
  </div>
</div>
