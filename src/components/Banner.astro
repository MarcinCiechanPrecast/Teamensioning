---
import { cn } from "@/lib/utils";

type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;

const variantClasses: Record<Variant, string> = {
  info: "bg-card text-foreground border-border",
  warning: "text-secondary border-secondary bg-card",
  error: "text-destructive border-destructive bg-card",
};
---

<div
  class:list={cn(
    "border-b px-4 py-3 text-center text-sm [&_a]:font-semibold [&_a]:text-inherit [&_a]:underline",
    variantClasses[variant],
  )}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>
