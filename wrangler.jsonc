{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamensioning",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // SESSION is pinned for production and for Previews: the adapter otherwise emits it without an ID,
  // which wrangler deploy auto-provisions but wrangler preview (Workers Builds on PR branches) rejects.
  "kv_namespaces": [{ "binding": "SESSION", "id": "076b524e2f714076ae4157d91b3aaf3e" }],
  "previews": { "kv_namespaces": [{ "binding": "SESSION", "id": "076b524e2f714076ae4157d91b3aaf3e" }] },
  "observability": {
    "enabled": true,
  },
}
