{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamensioning",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Pinned so every deploy path (wrangler deploy, Workers Builds previews) binds the same namespace;
  // the adapter would otherwise emit SESSION without an ID and rely on auto-provisioning.
  "kv_namespaces": [{ "binding": "SESSION", "id": "076b524e2f714076ae4157d91b3aaf3e" }],
  "observability": {
    "enabled": true,
  },
}
