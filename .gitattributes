# Normalize text files to LF in the repo and in every checkout, so Prettier
# (endOfLine: "lf" by default) and ESLint pass on Windows as they do in CI.
* text=auto eol=lf

# Binary assets: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
